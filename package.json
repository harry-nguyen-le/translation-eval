{
  "name": "translation-eval",
  "version": "0.1.0",
  "private": true,
  "description": "ICU-aware translation QA utilities.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "i18n:mixed-script-detection": "bun run scripts/mixed-script-detection.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.10"
}
