{
  "name": "translation-eval",
  "version": "0.1.0",
  "private": true,
  "description": "ICU-aware translation QA utilities.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "i18n:escape-character-preservation": "bun run scripts/escape-character-preservation.ts",
    "i18n:html-layout-preservation": "bun run scripts/html-layout-preservation.ts",
    "i18n:icu-syntax-preservation": "bun run scripts/icu-syntax-preservation.ts",
    "i18n:markdown-preservation": "bun run scripts/markdown-preservation.ts",
    "i18n:mixed-script-detection": "bun run scripts/mixed-script-detection.ts",
    "i18n:url-preservation": "bun run scripts/url-preservation.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.5",
    "character-entities": "^2.0.2",
    "htmlparser2": "^12.0.0",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.10"
}
